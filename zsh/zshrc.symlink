# ========================
# Dotfiles paths
# ========================
export ZSH="$HOME/.dotfiles"
export PROJECTS="$HOME/Desktop/play"
export TRY_PATH="$PROJECTS/tries"

# Load private environment variables from ~/.localrc
if [[ -a ~/.localrc ]]; then
  source ~/.localrc
fi

# ========================
# Load all .zsh files
# ========================
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# Load path files first
for file in ${(M)config_files:#*/path.zsh}; do
  source $file
done

# Load everything but path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}; do
  source $file
done

# ========================
# Zsh autocomplete
# ========================
autoload -Uz compinit
compinit

# Load completion files after compinit
for file in ${(M)config_files:#*/completion.zsh}; do
  source $file
done

unset config_files

# ========================
# Better history search
# ========================
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# VTE terminals (Tilix, GNOME Terminal)
if [[ $TILIX_ID ]] || [[ $VTE_VERSION ]]; then
  source /etc/profile.d/vte.sh
fi

# ========================
# ASDF (Pacman installation)
# ========================
# Source ASDF from Pacman
if [[ -f /usr/share/zsh/site-functions/asdf.zsh ]]; then
  source /usr/share/zsh/site-functions/asdf.zsh
fi

# Put shims first in PATH so asdf Ruby/Go override system versions
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# Add ASDF completions to fpath
fpath=(${ASDF_DATA_DIR:-$HOME/.asdf}/completions $fpath)

# Initialize compinit again for completions
autoload -Uz compinit
compinit

# ========================
# ASDF plugins / environment
# ========================
# Golang plugin
ASDF_GOLANG_MOD_VERSION_ENABLED=true
if [[ -f ${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh ]]; then
  source ${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh
fi

# Put Go binaries before asdf shims to avoid buildid errors
if command -v go &> /dev/null; then
  export PATH="$(go env GOBIN):$(go env GOPATH)/bin:$PATH"
fi

eval "$(try init)"
